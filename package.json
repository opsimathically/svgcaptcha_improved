{
  "name": "@opsimathically/svgcaptcha_improved",
  "version": "0.0.3",
  "description": "Modification of the original svgcaptcha node package to include a significant amount of randomization to eliminate current implementations of svgcaptcha solvers.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "node --require ts-node/register --require tsconfig-paths/register --test test/**/*.test.ts",
    "docs": "typedoc"
  },
  "keywords": [
    "svg",
    "captcha",
    "svgcaptcha",
    "improved",
    "less solvable"
  ],
  "homepage": "https://github.com/opsimathically/svgcaptcha_improved",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/node-forge": "^1.3.11",
    "@types/opentype.js": "^1.3.8",
    "@types/wtfnode": "^0.7.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.1",
    "typedoc-plugin-markdown": "^4.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "wtfnode": "^0.10.0"
  },
  "author": "Jason Medeiros (see original author of svgcaptcha page for base svgcaptcha code)",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsimathically/svgcaptcha_improved.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@swc/core": "^1.11.24",
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "command-line-args": "^6.0.1",
    "command-line-usage": "^7.0.3",
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.1",
    "source-map-support": "^0.5.21"
  }
}
